{
  "name": "losslesspack",
  "version": "1.0.0",
  "description": "Production-grade, lossless data compression library and CLI for Node.js and Supabase.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "losslesspack": "./bin/losslesspack.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./supabase": {
      "import": {
        "types": "./dist/supabase/index.d.ts",
        "default": "./dist/supabase/index.js"
      },
      "require": {
        "types": "./dist/supabase/index.d.cts",
        "default": "./dist/supabase/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench": "node bin/losslesspack.js bench"
  },
  "keywords": [
    "compression",
    "lossless",
    "zlib",
    "gzip",
    "brotli",
    "zstd",
    "supabase",
    "postgres",
    "bytea",
    "database-storage"
  ],
  "author": "IG-Creation",
  "license": "MIT",
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@mongodb-js/zstd": "^1.2.2"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^2.1.8",
    "fast-check": "^3.23.2",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
